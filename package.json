{
  "name": "@standhigher/react-email-editor",
  "version": "0.3.0",
  "type": "module",
  "description": "React email template editor with drag-and-drop blocks, rich text, JSON storage, and HTML export.",
  "keywords": [
    "react",
    "email-editor",
    "email-builder",
    "email-template",
    "html-email",
    "newsletter",
    "drag-and-drop",
    "rich-text-editor",
    "typescript",
    "json",
    "go-template"
  ],
  "author": "Nono",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "tsup",
    "build:watch": "tsup --watch src",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p playground",
    "lint": "oxlint . --deny-warnings --report-unused-disable-directives",
    "lint:fix": "pnpm lint --fix"
  },
  "peerDependencies": {
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "18.3.1",
    "tsup": "^8",
    "typescript": "^5",
    "vite": "^8.3.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/highlight": "^1.2.5",
    "@lezer/html": "^1.3.13",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0"
  }
}
